# Copy this file to `.env` (or `.env.production`) and fill in the real
# backend URL once it's deployed. Vite only exposes variables prefixed
# with VITE_ to the frontend code — see src/config/constants.js.
#
# Local development: leave .env absent entirely, constants.js falls back
# to ws://localhost:8766 automatically.
#
# Production: once your backend is deployed somewhere with a real domain,
# set this to that domain's WebSocket endpoint. IMPORTANT: if your
# Netlify site is served over https:// (it will be, by default), this
# MUST be wss:// (secure WebSocket), not ws:// — browsers block insecure
# WebSocket connections from an https page (mixed content). ws:// will
# silently fail to connect and you'll just see it try to re connect forever.
VITE_WS_URL=wss://your-backend-host.example.com
