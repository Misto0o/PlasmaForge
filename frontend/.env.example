# Copy this file to `.env` (or set directly in Netlify's dashboard) once
# your backend is deployed. Vite only exposes variables prefixed with
# VITE_ to the frontend code — see src/config/constants.js.
#
# Local development: leave .env absent entirely, constants.js falls back
# to ws://localhost:8765/ws automatically.
#
# Production: set this to your deployed backend's WebSocket endpoint,
# INCLUDING the /ws path. IMPORTANT: if your Netlify site is served over
# https:// (it will be, by default), this MUST be wss:// (secure
# WebSocket), not ws:// — browsers block insecure WebSocket connections
# from an https page (mixed content). ws:// will silently fail to
# connect and you'll just see it try to reconnect forever.
VITE_WS_URL=wss://your-backend-host.example.com/ws